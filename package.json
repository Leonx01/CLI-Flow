{
  "name": "cliflow",
  "version": "0.1.0",
  "description": "CLI Flow Engine — DAG workflow orchestrator powered by OpenCLI adapters",
  "type": "module",
  "bin": {
    "cliflow": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --noEmitOnError false && npm run build:web",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "ink": "^5.0.1",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "peerDependencies": {
    "@jackwener/opencli": "^1.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^3.0.0"
  },
  "author": "Leonx01",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  }
}
